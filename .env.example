# ==============================================================================
# ETYMO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Le credenziali Supabase sono opzionali.
# Se non fornite, l'app funzionerà perfettamente in modalità locale/offline
# utilizzando il dataset statico integrato (250+ parole ed etimologie verificate).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
